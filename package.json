{
  "name": "urna-simulada-educacional",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["api", "web"],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w api\" \"npm run dev -w web\"",
