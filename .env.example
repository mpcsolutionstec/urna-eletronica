PORT=4000
# Configure somente no servidor/API. Nunca coloque sb_secret_* no frontend.
SUPABASE_PROJECT_ID=kpevvdhvnzkontwcvwyd
# Gere uma nova chave secreta no Supabase: a chave compartilhada no chat deve ser rotacionada.
