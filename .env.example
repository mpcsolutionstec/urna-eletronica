ADMIN_USERNAME=admin
# Gere o hash com: npm run admin:hash -w api; copie o valor em vez de armazenar a senha.
ADMIN_PASSWORD_HASH=COLE_O_HASH_GERADO_AQUI
ADMIN_SESSION_KEY=change-me-to-a-long-random-session-secret
INTEGRITY_HMAC_KEY=change-me-to-another-long-random-secret
CPF_HMAC_KEY=change-me-to-a-third-long-random-secret
WEB_ORIGIN=http://localhost:5173,https://mpcsolutionstec.github.io
